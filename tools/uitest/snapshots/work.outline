html[data-kind]
  head
    meta *
    link *
    title
  body
    header.top
      div.top-in
        a.brand
          img
          span
        nav#
          a *
        div.tools
          button.ic#
            svg
              circle
              path
          a.ic *
            svg
              path
          button.ic.th#[role=switch]
            svg.th-sun
              defs
                radialgradient#
                  stop.sun-a
                  stop.sun-b
              g.sun-rays
                line *
              circle
            svg.th-moon
              defs
                lineargradient#
                  stop.moon-c
                  stop.moon-d
              path
              path.moon-star
              circle.moon-star
      div#
    main.wrap
      div.crumbs
        a
        span *
      div.page-h
        div
          h1
          p.lead
        div.seg#
          button.on[data-v]
          button[data-v]
      div.toolbar
        input#
        div.chips#
          button.on[data-v]
          button[data-v] *
        select.sel#
          option *
          optgroup
            option *
          option
      div# *
    footer.foot.wrap
      span *
    div.palette#[role=dialog]
      div.pal
        div.pal-in
          input#
          kbd
        div.gresults#
        div.pal-ft
          span *
          button.linkish[data-dopen] *
    aside.drawer#[role=dialog]
    div#[role=status]
